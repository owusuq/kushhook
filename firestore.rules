rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function path_(c, id) { return /databases/$(db)/documents/$(c)/$(id); }
    function member() { return signedIn() && exists(path_('users', uid())); }
    function isAdmin() { return exists(path_('admins', uid()))
      || (request.auth.token.email == 'daakyehenefoundation@gmail.com' && request.auth.token.email_verified == true); }

    match /admins/{id} { allow get: if signedIn() && id == uid(); }

    match /usernames/{name} {
      allow create: if signedIn() && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid()
        && !exists(path_('users', uid()))
        && getAfter(path_('users', uid())).data.username == name;
    }
    match /users/{id} {
      allow get: if signedIn() && (id == uid() || member());
      allow list: if member();
      allow create: if signedIn() && id == uid()
        && request.resource.data.keys().hasOnly(['name','username','nameLower','adult'])
        && request.resource.data.adult == true
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && getAfter(path_('usernames', request.resource.data.username)).data.uid == uid();
    }
    match /friends/{id} {
      allow read: if member() && uid() in resource.data.users;
      allow create: if member()
        && request.resource.data.keys().hasOnly(['users','from','status'])
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && uid() in request.resource.data.users
        && exists(path_('users', request.resource.data.users[0]))
        && exists(path_('users', request.resource.data.users[1]))
        && request.resource.data.from == uid()
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'accepted' && isAdmin()));
      allow update: if member() && uid() in resource.data.users && (
        (resource.data.status == 'pending' && resource.data.from != uid()
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.status != 'blocked' && request.resource.data.status == 'blocked'
          && request.resource.data.blockedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','blockedBy']))
        || (resource.data.status == 'accepted' && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clear'])
          && request.resource.data.clear[uid()] == request.time
          && request.resource.data.clear.diff(resource.data.get('clear', {})).affectedKeys().hasOnly([uid()])));

      match /messages/{m} {
        function chat() { return get(path_('friends', id)).data; }
        allow read: if member() && uid() in chat().users && chat().status == 'accepted';
        allow create: if member() && uid() in chat().users && chat().status == 'accepted'
          && request.resource.data.keys().hasOnly(['from','text','at','kind','path','name'])
          && (!('path' in request.resource.data) || (request.resource.data.kind in ['image','video','file']
              && request.resource.data.path is string
              && request.resource.data.path.matches('chats/' + id + '/' + uid() + '/.*')
              && request.resource.data.name is string && request.resource.data.name.size() <= 100))
          && request.resource.data.from == uid() && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || 'path' in request.resource.data);
        allow delete: if member() && uid() in chat().users && (resource.data.from == uid() || isAdmin());
      }
    }
    match /posts/{p} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['uid','username','type','text','at'])
        && request.resource.data.uid == uid()
        && request.resource.data.username == get(path_('users', uid())).data.username
        && request.resource.data.type in ['link','odds']
        && (request.resource.data.type == 'link' || isAdmin())
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time;
      allow delete: if member() && (resource.data.uid == uid() || isAdmin());
    }
  }
}
